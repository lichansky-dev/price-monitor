# Long id from the sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
# Service account key file (share the sheet with its client_email as Editor)
GOOGLE_CREDENTIALS=service_account.json
# Telegram bot from @BotFather and chat ids that receive alerts (comma-separated)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_IDS=
